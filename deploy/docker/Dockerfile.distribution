# syntax=docker/dockerfile:1
FROM golang:1.26 AS builder
WORKDIR /src
# 国内主机构建依赖代理（海外环境无感回退 direct）
ENV GOPROXY=https://goproxy.cn,direct
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/distribution ./cmd/distribution-service

FROM alpine:3.22
WORKDIR /app
COPY --from=builder /out/distribution /app/distribution
EXPOSE 8090
CMD ["/app/distribution"]
