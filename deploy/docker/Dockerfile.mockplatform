# syntax=docker/dockerfile:1
FROM golang:1.26 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/mockplatform ./cmd/mock-platform

FROM alpine:3.22
WORKDIR /app
COPY --from=builder /out/mockplatform /app/mockplatform
EXPOSE 9091
CMD ["/app/mockplatform"]
